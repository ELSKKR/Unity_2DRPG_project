    intro:
      lines:
      - "\uFF08\u865B\u5F31\u5730\u9760\u8457\u7246\uFF09\u62B1\u6B49\u554A\uFF0C\u6700\u8FD1\u8EAB\u9AD4\u4E0D\u592A\u8212\u670D\uFF0C\u8AAA\u8A71\u6709\u9EDE\u5598\u2026\u2026"
      choices:
      - label: "\u59B3\u9084\u597D\u55CE\uFF1F"
        reactionLines:
        - "\u6C92\u4E8B\uFF0C\u5C31\u662F\u611F\u67D3\u4E86\u98A8\u5BD2\uFF0C\u9700\u8981\u8CFD\u52D2\u5148\u751F\u7149\u7684\u85E5\u3002\u4F60\u80FD\u5E6B\u6211\u53BB\u627E\u4ED6\u55CE\uFF1F\u4ED6\u5728\u6751\u5B50\u53E6\u4E00\u982D\u3002"
        acceptsQuest: 1
        completesHandIn: 0
        markEventID: 
        requiredIntel: {fileID: 0}
        grantsIntel: {fileID: 11400000, guid: fe57699aa3a26614b81e46d47166121a, type: 2}
      - label: "\u6709\u4EC0\u9EBC\u6211\u80FD\u5E6B\u5FD9\u7684\u55CE\uFF1F"
        reactionLines:
        - "\u5982\u679C\u4F60\u4E0D\u4ECB\u610F\u7684\u8A71\u2026\u2026\u6751\u5B50\u53E6\u4E00\u982D\u7684\u8CFD\u52D2\u5148\u751F\u6703\u7149\u85E5\uFF0C\u4F60\u80FD\u5E6B\u6211\u53BB\u554F\u554F\u4ED6\u55CE\uFF1F"
        acceptsQuest: 1
        completesHandIn: 0
        markEventID: 
        requiredIntel: {fileID: 0}
        grantsIntel: {fileID: 11400000, guid: fe57699aa3a26614b81e46d47166121a, type: 2}
      - label: "\u5357\u908A\u5C4B\u5B50\u9580\u53E3\u5750\u8457\u7684\u90A3\u4F4D\u5148\u751F\u662F\u8AB0\uFF1F"
        reactionLines:
        - "\u4F60\u8AAA\u4E9E\u723E\u5148\u751F\u55CE\uFF1F\u4ED6\u4EE5\u524D\u662F\u66FF\u6751\u5B50\u64CB\u4E8B\u7684\u4EBA\u3002"
        - "\u524D\u9663\u5B50\u4ED6\u4E00\u500B\u4EBA\u534A\u591C\u9032\u4E86\u5317\u908A\u7684\u6797\u5B50\uFF0C\u56DE\u4F86\u6642\u53D7\u4E86\u50B7\uFF0C\u817F\u5230\u73FE\u5728\u9084\u6C92\u597D\u3002"
        - "\u807D\u8AAA\u8DDF\u4E86\u4ED6\u5F88\u4E45\u7684\u528D\u4E5F\u5F04\u4E1F\u4E86\uFF0C\u813E\u6C23\u58DE\u5F97\u5F88\uFF0C\u8AB0\u53BB\u642D\u8A71\u90FD\u4E0D\u7406\u2026\u2026\u516B\u6210\u662F\u70BA\u4E86\u9019\u500B\u3002"
        acceptsQuest: 0
        completesHandIn: 0
        markEventID: 
        requiredIntel: {fileID: 0}
        grantsIntel: {fileID: 11400000, guid: 8f051ec1cc679db4c97c9c6f417a035f, type: 2}
      - label: "\u6211\u60F3\u96E2\u958B\u9019\u500B\u6751\u5B50\uFF0C\u8A72\u600E\u9EBC\u8D70\uFF1F"
