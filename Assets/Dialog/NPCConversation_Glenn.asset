      startSound: {fileID: 0}
    handIn:
      lines:
      - "\u4F60\u624B\u4E0A\u90A3\u500B\u2026\u2026\u662F\u5F9E\u795E\u793E\u64BF\u7684\uFF1F\u6211\u6C92\u4EC0\u9EBC\u5370\u8C61\uFF0C\u4F60\u53BB\u554F\u554F\u8001\u8C9D\u5427\uFF0C\u4ED6\u5728\u9019\u6751\u5B50\u4F4F\u6700\u4E45\u3002"
