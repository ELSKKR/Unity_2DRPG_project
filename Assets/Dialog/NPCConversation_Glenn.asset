    intro:
      lines:
      - "\u4F60\u662F\u5916\u5730\u4F86\u7684\u65C5\u4EBA\u5427\uFF1F\u6B63\u597D\uFF0C\u80FD\u4E0D\u80FD\u5E6B\u6751\u5B50\u4E00\u500B\u5FD9\uFF1F"
      - "\u6E56\u908A\u90A3\u5EA7\u820A\u795E\u793E\uFF0C\u9019\u5E7E\u5929\u7E3D\u6709\u6751\u6C11\u8AAA\u770B\u5230\u602A\u5149\u3002\u6211\u5E74\u7D00\u5927\u4E86\u8D70\u4E0D\u52D5\uFF0C\u4F60\u80FD\u53BB\u770B\u770B\u55CE\uFF1F"
