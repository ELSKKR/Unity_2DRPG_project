        acceptsQuest: 1
      - label: "\u90A3\u5EA7\u795E\u793E\u600E\u9EBC\u4E86\u55CE\uFF1F"
        reactionLines:
        - "\u807D\u8AAA\u5F88\u4E45\u4EE5\u524D\u6E56\u88E1\u51FA\u904E\u4E8B\uFF0C\u4E4B\u5F8C\u795E\u793E\u5C31\u6C92\u4EBA\u7BA1\u4E86\u3002\u53EF\u80FD\u53EA\u662F\u50B3\u8A00\uFF0C\u4F46\u6751\u6C11\u4E0D\u5B89\uFF0C\u4F60\u53BB\u78BA\u8A8D\u4E00\u4E0B\u4E5F\u597D\u3002"
        acceptsQuest: 1
      typingSound: {fileID: 0}
      startSound: {fileID: 0}
    reminder:
      lines:
      - "\u795E\u793E\u90A3\u908A\u9084\u597D\u55CE\uFF1F\u5C0F\u5FC3\u9EDE\uFF0C\u5225\u592A\u9760\u8FD1\u6E56\u908A\u3002"
      choices: []
